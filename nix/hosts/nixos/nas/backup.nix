let
  qnapHost = "100.127.86.79";
in
{ config, pkgs, ... }:
{
  age.identityPaths = [ "/etc/ssh/ssh_host_ed25519_key" ]; # on all NixOS machines
  age.secrets.restic-password.file = ./secrets/restic-password.age;
  age.secrets.restic-qnap-rest-container.file = ./secrets/restic-qnap-rest-container.age;
  age.secrets.healthchecks-nas-to-qnap-url.file = ./secrets/healthchecks-nas-to-qnap-url.age;

  services.restic.backups.dad = {
    initialize = true;
    repository = "rest:http://${qnapHost}:8000/nas/";
    passwordFile = config.age.secrets.restic-password.path;
    environmentFile = config.age.secrets.restic-qnap-rest-container.path;
    paths = [
      "/tank/drive"
      "/tank/photos" # immich backs up it's own DB at 2:00am itself, then this backs up everything at 2:30am
    ];
    exclude = [
      # these can be regenerated by immich so don't worry about backing them up
      "/tank/photos/thumbs"
      "/tank/photos/encoded-video"
    ];
    # Immich recommends (to avoid desync between the DB and the actual uploaded files) to fully stop.
    backupPrepareCommand = "systemctl stop immich-server.service";
    backupCleanupCommand = "systemctl start immich-server.service";
    timerConfig = {
      OnCalendar = "02:30";
      Persistent = true; # runs a missed backup after downtime
      RandomizedDelaySec = "10m"; # jitter
    };
    pruneOpts = [ 
      "--keep-daily 7" # Keep the newest snapshot from each of the last 7 days
      "--keep-weekly 4" # Also keep one per week for the last 4 weeks
      "--keep-monthly 12" # Also keep one per month for the last 12 months
      # any snapshots older than 12 months are pruned
    ];
  };

  systemd.services.restic-backups-dad = {
    after = [ "network-online.target" "tailscaled.service" ];
    wants = [ "network-online.target" ];
    serviceConfig.ExecStartPost = "-${pkgs.writeShellScript "restic-dad-ping" ''
      ${pkgs.curl}/bin/curl -fsS -m 10 --retry 3 -o /dev/null "$(cat ${config.age.secrets.healthchecks-nas-to-qnap-url.path})"
    ''}";
    unitConfig.OnFailure = [ "restic-dad-ping-fail.service" ];
  };

  # on failure, healthcheck fail immediately
  systemd.services.restic-dad-ping-fail = {
    serviceConfig.Type = "oneshot";
    script = ''
      ${pkgs.curl}/bin/curl -fsS -m 10 --retry 3 -o /dev/null "$(cat ${config.age.secrets.healthchecks-nas-to-qnap-url.path})/fail"
    '';
  };
}
